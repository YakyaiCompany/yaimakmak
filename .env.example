# These values are bundled into the browser. Never place secrets, API keys,
# credentials, or private URLs in variables prefixed with VITE_.

# Use a same-origin HTTPS endpoint. The server must validate, rate-limit, and
# protect this endpoint against CSRF and automated submissions.
VITE_CONTACT_ENDPOINT=/api/leads

# Optional. Only HTTPS embeds from YouTube or Vimeo are accepted by the UI.
# Leave empty to hide the video action.
VITE_HERO_VIDEO_URL=

# Optional. Use only for a client-facing prototype. When true and no contact
# endpoint is configured, forms show an explicit simulated-success state and do
# not transmit or store personal data. Keep false in production.
VITE_DEMO_MODE=false
